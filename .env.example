# Supabase (públicas: van al navegador, solo se usan para el login del admin)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role: SOLO servidor. Nunca le pongas el prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# OPCIONAL. Vacío: el QR apunta a https://tu-dominio/registro
# Con valor: el QR apunta a /registro?k=<valor> y sin él no se puede registrar.
# Genera uno en la terminal con: openssl rand -hex 16
QR_TOKEN=

# Ubicación de Tempenchile (clic derecho en Google Maps → copiar coordenadas)
RESTAURANTE_LAT=
RESTAURANTE_LNG=
RADIO_METROS=100

# Correos con acceso a /admin, separados por coma
ADMIN_EMAILS=
